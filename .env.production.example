# Copy to a protected deployment-specific environment file. Never commit real secrets.
PRODMIND_VERSION=1.0.0
PRODMIND_BIND_ADDRESS=127.0.0.1
PRODMIND_API_PORT=8088
PRODMIND_LOG_LEVEL=INFO

PRODMIND_TEMPO_URL=https://tempo.example.internal
PRODMIND_LOKI_URL=https://loki.example.internal
PRODMIND_PROMETHEUS_URL=https://prometheus.example.internal

# JSON mapping. Generate a different random secret for every project.
PRODMIND_PROJECT_ENGINEER_KEYS={"example-project":"replace-with-random-secret-at-least-24-characters"}
PRODMIND_CORS_ORIGINS=https://app.example.com
PRODMIND_TRUSTED_HOSTS=support.example.com

PRODMIND_CONNECTOR_TIMEOUT_SECONDS=5
PRODMIND_CONNECTOR_MAX_RESPONSE_BYTES=5000000
PRODMIND_OBSERVABILITY_TLS_VERIFY=true
PRODMIND_OBSERVABILITY_CA_FILE=
PRODMIND_TEMPO_BEARER_TOKEN=
PRODMIND_LOKI_BEARER_TOKEN=
PRODMIND_PROMETHEUS_BEARER_TOKEN=

PRODMIND_MEMORY_RETENTION_DAYS=90
PRODMIND_MEMORY_MAX_RECORDS_PER_PROJECT=2000
PRODMIND_CHANGE_RETENTION_DAYS=30
PRODMIND_CHANGE_MAX_RECORDS_PER_PROJECT=5000

PRODMIND_LLM_PROVIDER=disabled
PRODMIND_LLM_MODEL=
PRODMIND_LLM_API_KEY=
