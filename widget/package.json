{
  "name": "@prodmind/widget",
  "version": "0.9.0-rc.1",
  "description": "Minimal browser SDK for evidence-first ProdMind investigations",
  "license": "MIT",
  "author": "ProdMind contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakaluote155/ProdMind.git",
    "directory": "widget"
  },
  "bugs": "https://github.com/kakaluote155/ProdMind/issues",
  "homepage": "https://github.com/kakaluote155/ProdMind#readme",
  "keywords": ["opentelemetry", "production-support", "trace-context"],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
