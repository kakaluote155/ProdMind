      "AIInvestigatorResponse": {
        "description": "Authenticated engineer-only AI explanation grounded in an existing RCA result.",
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/InvestigatorClaim"
            },
            "title": "Claims",
            "type": "array"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/InvestigatorEvidenceReference"
            },
            "title": "Evidence",
            "type": "array"
          },
          "incident_id": {
            "title": "Incident Id",
            "type": "string"
          },
          "missing_evidence": {
            "items": {
              "type": "string"
            },
            "title": "Missing Evidence",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "next_steps": {
            "items": {
              "enum": [
                "inspect_trace",
                "inspect_logs",
                "inspect_metrics",
                "inspect_changes",
                "inspect_history",
                "ask_for_context"
              ],
              "type": "string"
            },
            "title": "Next Steps",
            "type": "array"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "root_cause": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RootCause"
              },
              {
                "type": "null"
              }
            ]
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "diagnosed",
              "insufficient_evidence"
            ],
            "title": "Status",
            "type": "string"
          },
          "turn": {
            "minimum": 1.0,
            "title": "Turn",
            "type": "integer"
          }
        },
        "required": [
          "session_id",
          "turn",
          "incident_id",
          "status",
          "root_cause",
          "provider",
          "answer",
          "claims",
          "missing_evidence",
          "next_steps",
          "evidence"
        ],
        "title": "AIInvestigatorResponse",
        "type": "object"
      },
