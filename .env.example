PRODMIND_ENV=development
PRODMIND_LOG_LEVEL=INFO
PRODMIND_API_PORT=8088
PRODMIND_LLM_PROVIDER=disabled
PRODMIND_LLM_MODEL=
PRODMIND_LLM_API_KEY=
PRODMIND_LLM_BASE_URL=https://api.openai.com/v1
PRODMIND_LLM_TIMEOUT_SECONDS=30

# AI Investigator sessions are in-memory, project/trace scoped and bounded.
PRODMIND_AI_SESSION_TTL_SECONDS=1800
PRODMIND_AI_SESSION_MAX_TURNS=8
PRODMIND_AI_SESSION_MAX_COUNT=1024

# External model context excludes Change details and Incident Memory by default.
PRODMIND_LLM_INCLUDE_CHANGE_CONTEXT=false
PRODMIND_LLM_INCLUDE_INCIDENT_MEMORY=false

# Required to access /api/v1/investigate* engineer endpoints.
# Replace this value before any non-local deployment.
PRODMIND_ENGINEER_API_KEY=change-me
