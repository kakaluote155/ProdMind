PRODMIND_ENV=development
PRODMIND_LOG_LEVEL=INFO
PRODMIND_API_PORT=8088
PRODMIND_LLM_PROVIDER=disabled
PRODMIND_LLM_MODEL=
PRODMIND_LLM_API_KEY=
PRODMIND_LLM_BASE_URL=https://api.openai.com/v1
PRODMIND_LLM_TIMEOUT_SECONDS=30

# AI Investigator sessions are in-memory, project/trace scoped and bounded.
PRODMIND_AI_SESSION_TTL_SECONDS=1800
PRODMIND_AI_SESSION_MAX_TURNS=8
PRODMIND_AI_SESSION_MAX_COUNT=1024

# External model context excludes Change details and Incident Memory by default.
PRODMIND_LLM_INCLUDE_CHANGE_CONTEXT=false
PRODMIND_LLM_INCLUDE_INCIDENT_MEMORY=false

# Required to access /api/v1/investigate* engineer endpoints.
# Development/demo compatibility only. Production rejects this global key.
PRODMIND_ENGINEER_API_KEY=change-me

# Production uses a JSON map with a different secret for every project.
PRODMIND_PROJECT_ENGINEER_KEYS=
PRODMIND_CORS_ORIGINS=http://localhost:8090
PRODMIND_TRUSTED_HOSTS=localhost,127.0.0.1

PRODMIND_CONNECTOR_TIMEOUT_SECONDS=5
PRODMIND_CONNECTOR_MAX_RESPONSE_BYTES=5000000
PRODMIND_OBSERVABILITY_TLS_VERIFY=true
PRODMIND_OBSERVABILITY_CA_FILE=
PRODMIND_TEMPO_BEARER_TOKEN=
PRODMIND_LOKI_BEARER_TOKEN=
PRODMIND_PROMETHEUS_BEARER_TOKEN=

PRODMIND_MEMORY_RETENTION_DAYS=90
PRODMIND_MEMORY_MAX_RECORDS_PER_PROJECT=2000
PRODMIND_CHANGE_RETENTION_DAYS=30
PRODMIND_CHANGE_MAX_RECORDS_PER_PROJECT=5000
